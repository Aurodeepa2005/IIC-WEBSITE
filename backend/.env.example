# Server configuration
PORT=5000
NODE_ENV=development

# CORS configuration (Frontend URL)
CORS_ORIGIN=http://localhost:3000

# Neon PostgreSQL Connection URLs
# DATABASE_URL: Pooled connection string (used by Prisma Client runtime with PgBouncer)
DATABASE_URL="postgresql://[user]:[password]@[neon_hostname]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"

# DIRECT_URL: Direct connection string (used by Prisma Migrate without PgBouncer)
DIRECT_URL="postgresql://[user]:[password]@[neon_hostname].[region].aws.neon.tech/[dbname]?sslmode=require"
